# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 처리되어 GitHub에 올라가지 않습니다. 키를 채팅에 붙여넣지 마세요.

# 1) 네이버 검색광고 API — searchad.naver.com > 도구 > API 사용 관리
NAVER_SEARCHAD_API_KEY=        # 엑세스라이선스 (Access License)
NAVER_SEARCHAD_SECRET_KEY=     # 비밀키 (Secret Key)
NAVER_SEARCHAD_CUSTOMER_ID=    # CUSTOMER_ID (숫자)

# 2) 네이버 커머스 API — apicenter.commerce.naver.com > 애플리케이션 등록
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# 3) 쿠팡 Open API — 쿠팡 윙 > 판매자정보 > 추가판매정보 > OPEN API 키 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=             # 업체코드 (A0000000 형식)

# 4) 네이버 검색 오픈API (쇼핑 순위 추적) — developers.naver.com > Application 등록 > 검색
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=
